
# Arguments:
# INPUT_DIR
# INPUT_NAME
# OUTPUT_NAMESPACE
# OUTPUT_DIR

# Based on https://jonathanhamberg.com/post/cmake-file-embedding/

file(READ "${INPUT_DIR}/${INPUT_NAME}" content HEX)
string(REGEX REPLACE "\\.[^.]*$" "" INPUT_NAME_NO_EXTENSION ${INPUT_NAME})
string(REGEX MATCHALL "([A-Fa-f0-9][A-Fa-f0-9])" SEPARATED_HEX ${content})

set(counter 0)
set(output_c "")

foreach (hex IN LISTS SEPARATED_HEX)

	string(APPEND output_c "0x${hex}, ")

	math(EXPR counter "${counter}+1")
	if (counter GREATER 16)
		string(APPEND output_c "\n    ")
		set(counter 0)
	endif()

endforeach()

set(output_h "
#pragma once

//
// This file is automatically generated by `cmake/FileEmbed.cmake` from `${INPUT_NAME}`.
//

#include <stdint.h>

namespace ${OUTPUT_NAMESPACE}
{
	extern uint8_t ${INPUT_NAME_NO_EXTENSION}Bytes[];
	extern size_t ${INPUT_NAME_NO_EXTENSION}Length;
}
")

set(output_c "

//
// This file is automatically generated by `cmake/FileEmbed.cmake` from `${INPUT_NAME}`.
//

#include \"${INPUT_NAME_NO_EXTENSION}.h\"

uint8_t ${OUTPUT_NAMESPACE}::${INPUT_NAME_NO_EXTENSION}Bytes[] = {
	${output_c}
};
size_t ${OUTPUT_NAMESPACE}::${INPUT_NAME_NO_EXTENSION}Length = sizeof(${OUTPUT_NAMESPACE}::${INPUT_NAME_NO_EXTENSION}Bytes);

")

file(WRITE "${OUTPUT_DIR}/${INPUT_NAME_NO_EXTENSION}.h" "${output_h}")
file(WRITE "${OUTPUT_DIR}/${INPUT_NAME_NO_EXTENSION}.cpp" "${output_c}")
