
# Arguments:
# SHADER_NAME
# OUTPUT_DIR

# Based on https://jonathanhamberg.com/post/cmake-file-embedding/

file(READ "${CMAKE_CURRENT_BINARY_DIR}/shaders/${SHADER_NAME}.bin" content HEX)
string(REGEX MATCHALL "([A-Fa-f0-9][A-Fa-f0-9])" SEPARATED_HEX ${content})

set(counter 0)
set(output_c "")

foreach (hex IN LISTS SEPARATED_HEX)

	string(APPEND output_c "0x${hex}, ")

	math(EXPR counter "${counter}+1")
	if (counter GREATER 16)
		string(APPEND output_c "\n    ")
		set(counter 0)
	endif()

endforeach()

set(output_h "
#pragma once

//
// This file is automatically generated by `cmake/ShaderGenerate.cmake` from `shaders/${SHADER_NAME}.hlsl`.
//

#include <stdint.h>

namespace Shaders
{
	extern uint8_t ${SHADER_NAME}Bytes[];
	extern size_t ${SHADER_NAME}Length;
}
")

set(output_c "

//
// This file is automatically generated by `cmake/ShaderGenerate.cmake` from `shaders/${SHADER_NAME}.hlsl`.
//

#include \"${SHADER_NAME}.h\"

uint8_t Shaders::${SHADER_NAME}Bytes[] = {
	${output_c}
};
size_t Shaders::${SHADER_NAME}Length = sizeof(Shaders::${SHADER_NAME}Bytes);

")

file(WRITE "${OUTPUT_DIR}/${SHADER_NAME}.h" "${output_h}")
file(WRITE "${OUTPUT_DIR}/${SHADER_NAME}.cpp" "${output_c}")